# The extension itself reads no environment variables: everything it needs is
# built into it, and anything in an extension can be read by anyone who
# installs it, so it must never hold a secret (AGENTS.md, rule 8).
#
# These only change how the checks and screenshot tools run. All optional.

# Which browser loads the extension for e2e tests, screenshots and store images:
# "chromium" (Playwright's, after `npm run setup`) or "msedge". Empty: found
# automatically (scripts/lib/browser.mjs). Google Chrome can't be used.
PW_CHANNEL=

# Set to 1 to watch the browser during e2e tests and screenshots.
HEADED=

# Ports for the test pages: e2e tests (8891) and screenshots (8892).
E2E_PORT=
SHOTS_PORT=

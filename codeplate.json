{
  "$schema": "https://codeplate.io/schema/codeplate-0.json",
  "spec": 0,
  "id": "browser-extension-starter",
  "name": "Browser Extension Starter",
  "version": "1.0.2",
  "kind": "app",
  "summary": "A Manifest V3 extension for Chrome and Edge (Firefox build too): popup, side panel, options, content script, typed storage and messages.",
  "tags": [
    "browser-extension",
    "chrome-extension",
    "manifest-v3",
    "typescript",
    "vite",
    "edge",
    "firefox",
    "side-panel",
    "playwright"
  ],
  "stack": [
    { "name": "node", "version": "24" },
    { "name": "vite", "version": "8.3.4" },
    { "name": "typescript", "version": "6.0.3" }
  ],
  "checks": {
    "command": "npm ci && npm run check",
    "requires": ["node"]
  },
  "license": "CodePlate-Free-1.2",
  "tier": "free",
  "media": [
    "docs/media/cover.png",
    "docs/media/page.png",
    "docs/media/popup.png",
    "docs/media/sidepanel.png",
    "docs/media/options.png",
    "docs/media/page-dark.png",
    "docs/media/sidepanel-dark.png",
    "docs/media/popup-dark.png"
  ]
}
